  def initialize(transport, session_opts, wql, namespace = T.unsafe(nil)); end

  # pkg:gem/winrm#lib/winrm/wsmv/wql_query.rb:29
  def process_response(response, &block); end

  protected

  # pkg:gem/winrm#lib/winrm/wsmv/wql_query.rb:59
  def create_body(body); end

  # pkg:gem/winrm#lib/winrm/wsmv/wql_query.rb:55
  def create_header(header); end

  private

  # pkg:gem/winrm#lib/winrm/wsmv/wql_query.rb:65
  def process_items(items, &block); end

  # pkg:gem/winrm#lib/winrm/wsmv/wql_query.rb:83
  def wql_body; end

  # pkg:gem/winrm#lib/winrm/wsmv/wql_query.rb:79
  def wql_header; end
end

# Authorization Error
#
# pkg:gem/winrm#lib/winrm/exceptions.rb:20
class WinRM::WinRMAuthorizationError < ::WinRM::WinRMError; end

# WinRM base class for errors
#
# pkg:gem/winrm#lib/winrm/exceptions.rb:17
class WinRM::WinRMError < ::StandardError; end

# non-200 response without a SOAP fault
#
# pkg:gem/winrm#lib/winrm/exceptions.rb:80
class WinRM::WinRMHTTPTransportError < ::WinRM::WinRMError
  # pkg:gem/winrm#lib/winrm/exceptions.rb:83
  def initialize(msg, status_code = T.unsafe(nil)); end

  # pkg:gem/winrm#lib/winrm/exceptions.rb:81
  def status_code; end
end

# A Fault returned in the SOAP response. The XML node contains Code, SubCode and Reason
#
# pkg:gem/winrm#lib/winrm/exceptions.rb:54
class WinRM::WinRMSoapFault < ::WinRM::WinRMError
  # pkg:gem/winrm#lib/winrm/exceptions.rb:59
  def initialize(code, subcode, reason); end

  # pkg:gem/winrm#lib/winrm/exceptions.rb:55
  def code; end

  # pkg:gem/winrm#lib/winrm/exceptions.rb:57
  def reason; end

  # pkg:gem/winrm#lib/winrm/exceptions.rb:56
  def subcode; end
end

# A Fault returned in the SOAP response. The XML node is a MSFT_WmiError
#
# pkg:gem/winrm#lib/winrm/exceptions.rb:68
class WinRM::WinRMWMIError < ::WinRM::WinRMError
  # pkg:gem/winrm#lib/winrm/exceptions.rb:72
  def initialize(error, error_code); end

  # pkg:gem/winrm#lib/winrm/exceptions.rb:70
  def error; end

  # pkg:gem/winrm#lib/winrm/exceptions.rb:69
  def error_code; end
end

# A Fault returned in the SOAP response. The XML node is a WSManFault
#
# pkg:gem/winrm#lib/winrm/exceptions.rb:42
class WinRM::WinRMWSManFault < ::WinRM::WinRMError
  # pkg:gem/winrm#lib/winrm/exceptions.rb:46
  def initialize(fault_description, fault_code); end

  # pkg:gem/winrm#lib/winrm/exceptions.rb:43
  def fault_code; end

  # pkg:gem/winrm#lib/winrm/exceptions.rb:44
  def fault_description; end
end
