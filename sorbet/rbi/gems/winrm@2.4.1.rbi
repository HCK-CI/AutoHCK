  private

  # pkg:gem/winrm#lib/winrm/http/response_handler.rb:58
  def raise_if_auth_error; end

  # pkg:gem/winrm#lib/winrm/http/response_handler.rb:48
  def raise_if_error; end

  # pkg:gem/winrm#lib/winrm/http/response_handler.rb:99
  def raise_if_soap_fault; end

  # pkg:gem/winrm#lib/winrm/http/response_handler.rb:79
  def raise_if_wmi_error; end

  # pkg:gem/winrm#lib/winrm/http/response_handler.rb:62
  def raise_if_wsman_fault; end

  # pkg:gem/winrm#lib/winrm/http/response_handler.rb:123
  def raise_transport_error; end

  # pkg:gem/winrm#lib/winrm/http/response_handler.rb:40
  def response_xml; end
end

# pkg:gem/winrm#lib/winrm/shells/retryable.rb:19
module WinRM::Shells; end

# Base class for remote shell
#
# pkg:gem/winrm#lib/winrm/shells/base.rb:28
class WinRM::Shells::Base
  include ::WinRM::Shells::Retryable

  # Create a new Cmd shell
  # @param connection_opts [ConnectionOpts] The WinRM connection options
  # @param transport [HttpTransport] The WinRM SOAP transport
  # @param logger [Logger] The logger to log diagnostic messages to
  # @param shell_opts [Hash] Options targeted for the created shell
  #
  # pkg:gem/winrm#lib/winrm/shells/base.rb:46
  def initialize(connection_opts, transport, logger, shell_opts = T.unsafe(nil)); end

  # Closes the shell if one is open
  #
  # pkg:gem/winrm#lib/winrm/shells/base.rb:85
  def close; end

  # @return [ConnectionOpts] connection options of the shell
  #
  # pkg:gem/winrm#lib/winrm/shells/base.rb:60
  def connection_opts; end

  # @return [Logger] logger used for diagnostic messages
  #
  # pkg:gem/winrm#lib/winrm/shells/base.rb:66
  def logger; end

  # Runs the specified command with optional arguments
  # @param command [String] The command or executable to run
  # @param arguments [Array] The optional command arguments
  # @param block [&block] The optional callback for any realtime output
  # @yieldparam [string] standard out response text
  # @yieldparam [string] standard error response text
  # @yieldreturn [WinRM::Output] The command output
  #
  # pkg:gem/winrm#lib/winrm/shells/base.rb:78
  def run(command, arguments = T.unsafe(nil), &block); end

  # @return [String] shell id of the currently opn shell or nil if shell is closed
  #
  # pkg:gem/winrm#lib/winrm/shells/base.rb:54
  def shell_id; end

  # @return [Hash] Options targeted for the created shell
  #
  # pkg:gem/winrm#lib/winrm/shells/base.rb:69
  def shell_opts; end

  # @return [String] uri that SOAP calls use to identify shell type
  #
  # pkg:gem/winrm#lib/winrm/shells/base.rb:57
  def shell_uri; end

  # @return [WinRM::HTTP::HttpTransport] transport used to talk with endpoint
  #
  # pkg:gem/winrm#lib/winrm/shells/base.rb:63
  def transport; end

  protected

  # pkg:gem/winrm#lib/winrm/shells/base.rb:147
  def command_output_message(shell_id, command_id); end

  # pkg:gem/winrm#lib/winrm/shells/base.rb:139
  def open_shell; end

  # pkg:gem/winrm#lib/winrm/shells/base.rb:143
  def out_streams; end

  # pkg:gem/winrm#lib/winrm/shells/base.rb:135
  def response_reader; end

  # pkg:gem/winrm#lib/winrm/shells/base.rb:131
  def send_command(_command, _arguments); end

  # pkg:gem/winrm#lib/winrm/shells/base.rb:157
  def with_command_shell(command, arguments = T.unsafe(nil)); end

  private

  # pkg:gem/winrm#lib/winrm/shells/base.rb:208
  def add_finalizer; end

  # pkg:gem/winrm#lib/winrm/shells/base.rb:181
  def cleanup_command(command_id); end

  # pkg:gem/winrm#lib/winrm/shells/base.rb:198
  def open; end

  # pkg:gem/winrm#lib/winrm/shells/base.rb:215
  def remove_finalizer; end

  # pkg:gem/winrm#lib/winrm/shells/base.rb:175
  def reset_on_error(error); end

  class << self
    # Ruby 3.1+ introduced a change where finalizers cannot allocate new threads.
    # This can raise a ThreadError when the WinRM shell cleanup tries to run in a Thread
    # during garbage collection. Previously, the gem used Thread.new in finalizers.
    #
    # Our solution preserves original behavior safely:
    # 1. Attempt cleanup in a new thread (same as before) for normal execution.
    # 2. If a ThreadError occurs specifically due to "can't alloc thread",
    #    defer cleanup to an at_exit block to ensure the shell is closed properly
    #    without crashing the program.
    # 3. Any other ThreadError is re-raised to avoid hiding unexpected issues.
    #
    # pkg:gem/winrm#lib/winrm/shells/base.rb:107
    def finalize(connection_opts, transport, shell_id); end
  end
end

